@startuml casos_de_uso
left to right direction
title Casos de uso del MVP - Brief estructurado OrigenTours
actor "Visitante\n(cliente potencial)" as Cli
actor "Asesor de Atención\nal cliente (logueado)" as Ase
actor "LLM" as LLM <<sistema>>

rectangle "Sistema de brief con GenAI" {
  usecase "UC1 Enviar solicitud\n(formulario web)" as UC1
  usecase "UC2 Iniciar sesión" as UC2
  usecase "UC3 Registrar solicitud\nrecibida por correo/redes" as UC3
  usecase "UC4 Anonimizar mensaje\n(Privacy Vault)" as UC4
  usecase "UC5 Generar brief estructurado" as UC5
  usecase "UC6 Detectar datos faltantes\ny sugerir preguntas" as UC6
  usecase "UC7 Restituir datos reales" as UC7
  usecase "UC8 Revisar, corregir y\nvalidar el brief" as UC8
  usecase "UC9 Consultar historial\nde briefs" as UC9
}
Cli --> UC1
Ase --> UC2
Ase --> UC3
Ase --> UC8
Ase --> UC9
UC1 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>
UC5 ..> UC7 : <<include>>
UC8 ..> UC2 : <<include>>
UC9 ..> UC2 : <<include>>
UC5 --> LLM
@enduml
